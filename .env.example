# ==============================================================================
# DB Upgrade Impact Analysis & Validation AI Agent - Environment Configuration
# Copy this file to .env and fill in the required values before running.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
APP_NAME="DB Upgrade Impact Analysis & Validation AI Agent"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Backend & Frontend Network Settings
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. Metadata & Vector Database (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db_upgrade_agent
POSTGRES_USER=upgrade_admin
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_URL=postgresql+psycopg://upgrade_admin:change_me_in_local_env@localhost:5432/db_upgrade_agent

# ------------------------------------------------------------------------------
# 4. Security & Governance Settings
# ------------------------------------------------------------------------------
# Must be a strong random secret (e.g., openssl rand -hex 32)
SECRET_KEY=replace_with_32_byte_hex_secret_key
# Fernet / AES key used to encrypt transient target DB connection credentials
# NEVER store target DB credentials in plaintext.
DB_CREDENTIAL_ENCRYPTION_KEY=replace_with_fernet_base64_key

# Upload Validation Constraints
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.json,.sql,.csv,.txt,.log

# Target DB Direct Connection Guardrails (Read-only enforced)
TARGET_DB_READ_ONLY=true
TARGET_DB_CONNECT_TIMEOUT_SEC=10
TARGET_DB_QUERY_TIMEOUT_SEC=30

# Official Vendor Documentation Allowlist (Comma-separated domains)
ALLOWED_DOC_DOMAINS=dev.mysql.com,downloads.mysql.com

# ------------------------------------------------------------------------------
# 5. AI / LLM & Hybrid RAG Settings
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
LLM_PRIMARY_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# 6. LangSmith Observability & Tracing
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=db-upgrade-impact-agent
